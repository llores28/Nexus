# Nexus runtime artifacts (generated by `nexus init` / journal commands).
# Profile and install manifest are the only tracked project configuration.
.nexus/*
!.nexus/profile.json
!.nexus/install-manifest.json
BOOTSTRAP.md

# Provider adapters and canonical skills are tracked because the install
# manifest owns them and a clean clone must be immediately diagnosable.
# Legacy Windsurf/Codeium files may remain locally for migration testing but
# are not Nexus v0.3 release sources.
.windsurf/
.codeiumignore

# Nexus - Exclude non-essential files
COMMIT_SUMMARY.md
NexusHealthMasterPlan.md
Nexus Health Audit and Tracking Plan.md
NexusUpgradePlan.md
linkedin-post.md
ws-bootstrap-master.code-workspace

